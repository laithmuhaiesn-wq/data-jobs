// api.derbani.com: the app's live answers without the PC (worker/api.js, docs/cloud-move-plan.md). Deploy:
//     npx wrangler@4 deploy -c worker/api.wrangler.jsonc
{
  "name": "kamkam-api",
  "compatibility_date": "2026-11-01",
  "main": "api.js",
  "workers_dev": true,
  "preview_urls": false,
  // the clock of the cloud jobs (worker/api.js startJobs): every hour at :05 UTC
  "triggers": { "crons": ["5,35 * * * *"] },
  "routes": [{ "pattern": "api.derbani.com", "custom_domain": true }],   // the cloud switch 2026-11-28 (the tunnel record was removed)
}
